# Copy to .env and fill with your Supabase project values.
#
# Esta rama es **solo MotoConecta** (greenfield): `supabase db reset` aplica la migración baseline
# `supabase/migrations/20260106000000_motoconecta_baseline.sql` + `supabase/seed.sql`, o pega
# `supabase/motoconecta/schema.sql` en SQL Editor y luego el seed (ver supabase/motoconecta/README.md).
#
# Dashboard → Project Settings → API:
#   - URL del proyecto → NEXT_PUBLIC_SUPABASE_URL (debe coincidir con tu Project Reference)
#   - anon (JWT) o clave publishable (sb_publishable_…): usa cualquiera de estas dos variables:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_anon_or_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Opcional: URL donde abre la app tras el enlace de recuperación de contraseña (debe estar en Redirect URLs de Supabase Auth).
# Ejemplo web: http://localhost:8080  o  https://tu-dominio.com
# SUPABASE_AUTH_REDIRECT_URL=
