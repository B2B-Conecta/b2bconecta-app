# Dashboard → Project Settings → API:
#   - URL del proyecto → NEXT_PUBLIC_SUPABASE_URL (debe coincidir con tu Project Reference)
#   - anon public (JWT) o clave publishable → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY
NEXT_PUBLIC_SUPABASE_URL=https://hnomevjbcxahzjiofzob.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9YQrnZLfgqxtXkQ55lWsaQ_w9s2Trqj

