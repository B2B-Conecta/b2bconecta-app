# Copy to .env or use: bash scripts/use_env.sh local|staging|production
#
# Local: supabase start && supabase db reset --yes
#   Keys: supabase status (Publishable)
#   Recovery emails: http://127.0.0.1:54324 (Mailpit)
#
# Dashboard remoto → Project Settings → API (URL + publishable/anon key)

# --- Local (Docker) ---
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000

# --- Staging ---
# NEXT_PUBLIC_SUPABASE_URL=https://lwrqjpqyitnveizshawc.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000

# --- Production ---
# NEXT_PUBLIC_SUPABASE_URL=https://ufrphhiynowsychgxvkn.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_publishable_key

# Debe coincidir con Site URL / Redirect URLs en Supabase Auth (y con --web-port al correr Flutter web).
# SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000
