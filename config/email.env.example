# Copiar a config/email.env (no commitear).
#
# LOCAL (recomendado): además copie config/email.env.local.example → config/email.env.local
#   bash scripts/serve_functions_local.sh
#   Correos en Mailpit → http://127.0.0.1:54324
#
# STAGING/PROD: bash scripts/configure_supabase_email_secrets.sh staging
#
# NO va en .env de la app Flutter. Reinicie serve_functions_local.sh tras cambiar SMTP.
#
# Cuenta remitente MotoLink (Gmail):
MOTOLINK_SMTP_USER=motolink.admin@gmail.com
MOTOLINK_SMTP_FROM="MotoLink <motolink.admin@gmail.com>"
MOTOLINK_SMTP_HOST=smtp.gmail.com
MOTOLINK_SMTP_PORT=587
#
# Contraseña de aplicación Gmail (Google → Seguridad → 2FA → Contraseñas de aplicaciones)
MOTOLINK_SMTP_PASS=
#
# Alias usados por supabase functions serve local:
SMTP_USER=motolink.admin@gmail.com
SMTP_FROM="MotoLink <motolink.admin@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASS=
