# Overrides SOLO para desarrollo local (supabase functions serve).
# Copiar a config/email.env.local — los correos se capturan en Mailpit:
#   http://127.0.0.1:54324
#
# Mantenga config/email.env con Gmail para staging:
#   bash scripts/configure_supabase_email_secrets.sh staging

MOTOLINK_SMTP_HOST=inbucket
MOTOLINK_SMTP_PORT=1025
MOTOLINK_SMTP_USER=
MOTOLINK_SMTP_PASS=local

SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=local
