# Production API + deep link para APK/iOS de lanzamiento.
# Web prod usa config/env/production.env → URL estable de la app web.
#
# Supabase Dashboard (ufrphhiynowsychgxvkn) → Auth → Redirect URLs:
#   com.carlosf12.motolinkProApp://auth-callback
#
# Obtenga la publishable key en Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://ufrphhiynowsychgxvkn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY

