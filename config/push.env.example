# Copiar a config/push.env (no commitear).
# Ejecutar:
#   bash scripts/configure_supabase_push_secrets.sh staging
#   bash scripts/configure_supabase_push_secrets.sh production
#
# Use un push.env distinto por máquina; nunca suba service_role ni FCM al repo.

# --- Dev / staging app (b2bconecta-db-dev) ---
STAGING_PROJECT_REF=kdrccmqcrruixuworlmz

# --- Main / production (b2bconecta-db) ---
PRODUCTION_PROJECT_REF=fzugzjcwdzcwfxgviltw

# Override explícito (opcional; si vacío, el script usa STAGING/PRODUCTION según target)
SUPABASE_PROJECT_REF=
SUPABASE_URL=

# Dashboard → Settings → API → service_role (secret) del proyecto activo
SUPABASE_SERVICE_ROLE_KEY=

# FCM — use uno de los dos:
# A) Legacy server key
FCM_SERVER_KEY=

# B) Recomendado: JSON de cuenta de servicio Firebase (FCM HTTP v1)
FCM_SERVICE_ACCOUNT_JSON=

PUSH_WEBHOOK_SECRET=

# Aliases locales (supabase/config.toml edge_runtime.secrets)
MOTOLINK_FCM_SERVER_KEY=
MOTOLINK_PUSH_WEBHOOK_SECRET=
