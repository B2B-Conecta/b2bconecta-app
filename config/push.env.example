# Copiar a config/push.env (no commitear).
# Ejecutar: bash scripts/configure_supabase_push_secrets.sh staging

# Staging project ref (opcional si usa target staging por defecto)
STAGING_PROJECT_REF=lwrqjpqyitnveizshawc
SUPABASE_URL=https://lwrqjpqyitnveizshawc.supabase.co

# Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# FCM — use uno de los dos:
# A) Legacy server key (Cloud Messaging API legacy habilitada en Google Cloud)
FCM_SERVER_KEY=

# B) Recomendado: JSON de cuenta de servicio Firebase (FCM HTTP v1)
# Firebase Console → Project settings → Service accounts → Generate new private key
# Pegar el JSON en una sola línea o como string escapado.
FCM_SERVICE_ACCOUNT_JSON=

PUSH_WEBHOOK_SECRET=

# Aliases locales (supabase/config.toml edge_runtime.secrets)
MOTOLINK_FCM_SERVER_KEY=
MOTOLINK_PUSH_WEBHOOK_SECRET=
