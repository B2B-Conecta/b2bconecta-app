# Copiar a config/smtp.env (gitignored) y completar SMTP_PASS.
# Gmail: usar "Contraseña de aplicación" (no la clave normal de la cuenta).
#   https://myaccount.google.com/apppasswords
#
# Aplicar en remoto:
#   bash scripts/configure_supabase_smtp.sh staging
#   bash scripts/configure_supabase_smtp.sh production
#
# Local (Auth envía por Gmail en lugar de Inbucket):
#   set -a && source config/smtp.env && set +a
#   supabase stop && supabase start

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=b2bconecta.ve@gmail.com
# Entrecomillar si Gmail te da la App Password con espacios: "xxxx xxxx xxxx xxxx"
SMTP_PASS=""
SMTP_ADMIN_EMAIL=b2bconecta.ve@gmail.com
SMTP_SENDER_NAME="B2B Conecta"

# Requerido por el script (Personal Access Token del Dashboard):
# https://supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=

# Project refs (B2B Conecta)
STAGING_PROJECT_REF=kdrccmqcrruixuworlmz
