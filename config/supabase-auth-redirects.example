#   https://b2bconecta-app-git-dev-b2bconecta.vercel.app/**
#   http://localhost:3000/**
#   http://127.0.0.1:3000/**
#   ve.com.b2bconecta.app://auth-callback
#
# === DEV (b2bconecta-db-dev / kdrccmqcrruixuworlmz) — data de trabajo ===
